{
  "name": "tab2api",
  "version": "0.1.0",
  "description": "Local-only, unofficial OpenAI-compatible bridge to a user-owned ChatGPT web session",
  "author": "Tang Vu",
  "homepage": "https://github.com/tang-vu/tab2api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tang-vu/tab2api.git"
  },
  "bugs": {
    "url": "https://github.com/tang-vu/tab2api/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "tab2api": "dist/cli/index.js",
    "tab2api-sidecar": "dist/sidecar/index.js"
  },
  "files": [
    "dist",
    "scripts/windows",
    "README.md",
    "README_VI.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "LICENSE",
    ".env.example"
  ],
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts start",
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test && npm run smoke",
    "start": "node dist/cli/index.js start",
    "login": "tsx src/cli/index.ts login",
    "doctor": "tsx src/cli/index.ts doctor",
    "smoke": "tsx src/cli/index.ts smoke",
    "reset-session": "tsx src/cli/index.ts reset-session",
    "keys": "tsx src/cli/index.ts keys",
    "usage": "tsx src/cli/index.ts usage",
    "desktop:prepare:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/prepare-desktop-bundle.ps1",
    "desktop:ui:check": "node --check desktop/ui/app.js && node --check desktop/ui/i18n.js && node --test desktop/ui/i18n.test.mjs",
    "desktop:check": "npm run desktop:ui:check && cargo fmt --manifest-path desktop/Cargo.toml --check && cargo clippy --manifest-path desktop/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path desktop/Cargo.toml --all-targets --all-features",
    "desktop:dev": "npm run build && tauri dev --config desktop/tauri.conf.json",
    "desktop:build:windows": "npm run desktop:prepare:windows && tauri build --bundles nsis --config desktop/tauri.conf.json",
    "desktop:smoke:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/smoke-desktop-bundle.ps1",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-autostart.ps1",
    "autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/status-autostart.ps1",
    "autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/remove-autostart.ps1",
    "tunnel:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-cloudflare-autostart.ps1",
    "tunnel:install:bearer-only": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-cloudflare-autostart.ps1 -AllowBearerOnly",
    "tunnel:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/status-cloudflare-autostart.ps1",
    "tunnel:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/remove-cloudflare-autostart.ps1",
    "test": "vitest run",
    "test:manual": "vitest run --config vitest.manual.config.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run desktop:ui:check"
  },
  "keywords": [
    "chatgpt",
    "browser-automation",
    "fastify",
    "openai-compatible",
    "playwright",
    "local-first",
    "tauri",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "pino": "^9.9.0",
    "playwright": "^1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "linkedom": "^0.18.12",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
