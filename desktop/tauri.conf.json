{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tab2api",
  "version": "0.2.1",
  "identifier": "dev.tangvu.tab2api",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "tab2api",
        "width": 1220,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "generated/sidecar": "sidecar",
      "../scripts/windows/install-cloudflare-autostart.ps1": "scripts/windows/install-cloudflare-autostart.ps1",
      "../scripts/windows/status-cloudflare-autostart.ps1": "scripts/windows/status-cloudflare-autostart.ps1",
      "../scripts/windows/remove-cloudflare-autostart.ps1": "scripts/windows/remove-cloudflare-autostart.ps1"
    }
  }
}
