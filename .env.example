# The server rejects every non-loopback host. Keep this value unchanged.
TAB2API_HOST=127.0.0.1
TAB2API_PORT=3210

# Optional. If omitted, a random token is created at .tab2api/api-token with restrictive permissions.
# TAB2API_API_TOKEN=replace-with-a-long-random-secret

TAB2API_DATA_DIR=.tab2api
TAB2API_PROFILE_DIR=.tab2api/browser-profile
TAB2API_HEADLESS=false

# Browser backend: playwright (bundled Chromium) or gpm (one existing GPM Login profile).
TAB2API_BROWSER_BACKEND=gpm
# Required when backend=gpm. Create/login to this single profile manually in GPM Login first.
TAB2API_GPM_PROFILE_ID=
TAB2API_GPM_BASE_URL=http://127.0.0.1:9495/api/v1

# Parallel browser tabs. Keep 1 for maximum reliability; try 2 only after testing your account/UI.
TAB2API_CONCURRENCY=1
TAB2API_QUEUE_CAPACITY=16
TAB2API_REQUEST_TIMEOUT_MS=120000
TAB2API_IMAGE_TIMEOUT_MS=300000
TAB2API_BODY_LIMIT_BYTES=262144
TAB2API_MEDIA_LIMIT_BYTES=10485760
TAB2API_DEBUG=false
TAB2API_LOG_LEVEL=info
