# Selected provider. Official APIs require separate explicit opt-in below.
# Browser provider. ChatGPT is the unchanged default. Experimental providers are CLI-only.
TAB2API_PROVIDER=chatgpt-web
# Do not enable without actual permission from the named provider for automated web access.
# These flags do not grant permission or override provider terms. See docs/providers.md.
TAB2API_EXPERIMENTAL_PROVIDERS=false
# TAB2API_PROVIDER_PERMISSION=claude-web

# The server rejects every non-loopback host. Keep this value unchanged.
TAB2API_HOST=127.0.0.1
TAB2API_PORT=3210

# Optional 24-512 visible ASCII characters. If omitted, a random token is created at
# .tab2api/api-token with restrictive permissions.
# TAB2API_API_TOKEN=replace-with-a-long-random-secret

TAB2API_DATA_DIR=.tab2api
TAB2API_PROFILE_DIR=.tab2api/browser-profile
TAB2API_HEADLESS=false

# Parallel browser tabs. Keep 1 for maximum reliability; try 2 only after testing your account/UI.
TAB2API_CONCURRENCY=1
TAB2API_QUEUE_CAPACITY=16
TAB2API_REQUEST_TIMEOUT_MS=120000
TAB2API_IMAGE_TIMEOUT_MS=300000
TAB2API_BODY_LIMIT_BYTES=262144
TAB2API_MEDIA_LIMIT_BYTES=10485760
# Run every turn in a ChatGPT Temporary Chat (nothing kept in account history) unless a
# request passes `temporary:false`. Incompatible with conversation_id and project routes.
TAB2API_TEMPORARY_CHAT=false

# Preflight ceiling for one serialized message, in estimated o200k tokens. The default is
# the largest measured single-message bound; lower it for accounts with smaller windows.
TAB2API_MAX_PROMPT_TOKENS=104000

TAB2API_DEBUG=false
TAB2API_LOG_LEVEL=info

# Optional personal Cloudflare Tunnel hostname used by the Windows Access verification script.
# TAB2API_TUNNEL_HOSTNAME=tab2api.example.com

# OPTIONAL official API transport; never a browser fallback. Generation can incur charges.
# TAB2API_PROVIDER=meta-api
TAB2API_ENABLE_PAID_API=false
# Set only the selected provider's key locally; never commit or share real keys.
# TAB2API_CLAUDE_API_KEY=your-workspace-scoped-key
# TAB2API_GROK_API_KEY=your-own-key
# TAB2API_META_API_KEY=your-own-key
# Required exact model ID from the provider console; no default/alias is guessed.
# TAB2API_API_MODEL=exact-model-id
TAB2API_API_MAX_OUTPUT_TOKENS=4096
# API mode currently requires CONCURRENCY=1 and TEMPORARY_CHAT=false.
